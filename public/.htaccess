# ==============================================================
#  L+H Website - Apache Konfiguration
#  Liegt in public/ und wird bei jedem `npm run build`
#  automatisch nach dist/ kopiert. Nicht in dist/ direkt editieren.
#
#  ZWEI GRUNDREGELN, die hier bewusst eingehalten werden:
#
#  1. Nur Direktiven der Override-Klasse FileInfo. DirectoryIndex
#     (Klasse Indexes) und Options (Klasse Options) sind auf dem
#     Server nicht erlaubt und beenden jede Anfrage mit HTTP 500.
#
#  2. Keine pauschalen Regeln. Eine .htaccess wirkt auch auf alle
#     Unterverzeichnisse. Liegen dort weitere Anwendungen (SSO,
#     Erfasserabrechnung, Inventarverwaltung), duerfen sie von den
#     Regeln dieser Seite nicht erfasst werden. Deshalb greift jede
#     Regel nur auf einem ausdruecklich benannten Pfad.
# ==============================================================


# --- 1) Routing ------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1a) Redirects von der alten PHP-Website.
  # Diese Adressen stehen noch in alten Fragebogen und auf Fremdseiten.
  # Der Parameter lng setzt die Sprache der App (i18next liest ihn mit
  # hoechster Prioritaet und merkt sie sich im localStorage).
  RewriteRule ^de/07_im\.php$  /imprint?lng=de  [NC,R=301,L]
  RewriteRule ^en/07_im\.php$  /imprint?lng=en  [NC,R=301,L]

  # 1b) Marker fuer die Cache-Header weiter unten. Reine Kennzeichnung,
  # kein Umschreiben - dadurch bleiben die Header auf diese Pfade
  # begrenzt und treffen keine fremden Verzeichnisse.
  RewriteRule ^assets/                    - [E=CACHE_IMMUTABLE:1]
  RewriteRule ^(wallpapers|clients|images)/ - [E=CACHE_WEEK:1]
  RewriteRule ^locales/                   - [E=CACHE_NONE:1]
  RewriteRule ^(index\.html)?$            - [E=CACHE_NONE:1]

  # 1c) Verzeichnis-Listings der eigenen Ordner unterbinden.
  # Ersetzt "Options -Indexes", das hier nicht erlaubt ist. Bewusst auf
  # die eigenen Verzeichnisse begrenzt - eine pauschale Regel wuerde
  # auch fremde Anwendungen mit 403 abweisen.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(assets|locales|wallpapers|clients|images)(/|$) - [F]

  # 1d) SPA-Fallback, ausdruecklich auf die Routen der App begrenzt.
  # Der React-Router kennt diese Pfade nur im Browser; ohne die Regel
  # liefert Apache dort 404. Bewusst KEIN Catch-all: alles, was hier
  # nicht steht, bleibt unangetastet und wird normal von Apache
  # behandelt - inklusive aller Unterverzeichnisse mit eigenen Apps.
  # Bei neuen Seiten in src/routes/routes.jsx hier ergaenzen.
  RewriteRule ^(automobile|contact|imprint|data-protection|directions|job-career|customer-satisfaction|financial-markets)/?$ index.html [L]

  # 1e) Startseite. Noetig, weil DirectoryIndex nicht erlaubt ist.
  RewriteRule ^$ index.html [L]
</IfModule>


# --- 2) MIME-Typen ---------------------------------------------
# Aeltere Apache-Versionen kennen woff2/avif nicht.
<IfModule mod_mime.c>
  AddType font/woff2  .woff2
  AddType font/woff   .woff
  AddType image/avif  .avif
</IfModule>


# --- 3) Kompression --------------------------------------------
# Das JS-Bundle ist ~4,5 MB unkomprimiert, ~1,5 MB gzip.
# Schriften und Bilder sind bereits komprimiert -> nicht erneut packen.
# Wirkt bewusst auch auf Unterverzeichnisse: Kompression ist fuer
# fremde Anwendungen unschaedlich und dort ebenso erwuenscht.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain \
                                        text/javascript application/javascript \
                                        application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
                                text/javascript application/javascript \
                                application/json image/svg+xml
</IfModule>


# --- 4) Caching ------------------------------------------------
# Ausschliesslich ueber die Marker aus 1b, also nur fuer die
# Verzeichnisse dieser Seite.
<IfModule mod_headers.c>

  # /assets/* traegt einen Content-Hash im Dateinamen. Bei einer
  # Aenderung entsteht ein neuer Name -> dauerhaft cachebar.
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_IMMUTABLE

  # Bilder aus public/ haben feste Namen. Moderat cachen, damit ein
  # ausgetauschtes Wallpaper nicht ein Jahr lang alt bleibt.
  Header set Cache-Control "public, max-age=604800" env=CACHE_WEEK

  # Uebersetzungen nie dauerhaft cachen.
  Header set Cache-Control "no-cache" env=CACHE_NONE

  # Die zweite Zeile faengt den Fall ab, dass die Startseite intern
  # auf index.html umgeschrieben wurde - Apache stellt Variablen dann
  # mit dem Praefix REDIRECT_ bereit.
  Header set Cache-Control "no-cache" env=REDIRECT_CACHE_NONE
</IfModule>
