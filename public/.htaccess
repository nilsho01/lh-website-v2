RewriteEngine On
RewriteBase /
 
# Wenn Datei oder Ordner existiert, nichts umschreiben
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
 
# Sonderfall Impressum und Datenschutz - die werden von Fragebögen angesteuert
RewriteRule ^de/impressum\.html$ /imprint [R=301,L]
 
# Sonst alles an React weitergeben
RewriteRule ^ index.html [L]
 
 
<IfModule mod_headers.c>
 
  # Build-Assets (/assets/*) tragen einen Content-Hash im Dateinamen.
  # Bei einer Aenderung entsteht ein neuer Name -> dauerhaft cachebar.
<FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
 
  # Bilder aus public/ haben feste Namen. Moderat cachen, damit ein
  # ausgetauschtes Wallpaper nicht ein Jahr lang alt bleibt.
<FilesMatch "\.(png|jpe?g|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
</FilesMatch>
 
  # index.html und die Uebersetzungen NIE dauerhaft cachen, sonst
  # sehen Besucher nach einem Deploy weiter die alte Version.
<FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
</FilesMatch>
 
  Header set X-Content-Type-Options "nosniff"
</IfModule>